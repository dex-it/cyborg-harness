{
  "id": "git",
  "version": "1.0.0",
  "engines": {
    "cyborg": "^1"
  },
  "provides": {
    "cyborg.git": {
      "version": "1.0",
      "guard": {
        "status": { "fs.read": 0 },
        "onChange": { "fs.read": 0 }
      }
    },
    "cyborg.tree-decoration": {
      "version": "1.0",
      "guard": {
        "marks": { "fs.read": 0 }
      }
    }
  },
  "permissions": {
    "fs.read": ["workspace"],
    "process": [
      {
        "program": "git",
        "args": ["--no-optional-locks", "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null", "status", "--porcelain=v1", "-z", "--branch"],
        "env": ["GIT_CONFIG_COUNT", "GIT_CONFIG_KEY_*", "GIT_CONFIG_VALUE_*"],
        "deny": ["-c", "--config-env", "--output", "--git-dir", "--work-tree", "--exec-path", "--ext-diff"]
      },
      {
        "program": "git",
        "args": ["--no-optional-locks", "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null", "config", "--show-scope", "--null", "--name-only", "--get-regexp", "^filter\\..+\\.(clean|process|required)$"],
        "env": ["LC_ALL"],
        "deny": ["-c", "--config-env", "--output", "--git-dir", "--work-tree", "--exec-path", "--ext-diff"]
      },
      {
        "program": "git",
        "args": ["--no-optional-locks", "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null", "ls-files", "--stage", "-z"],
        "deny": ["-c", "--config-env", "--output", "--git-dir", "--work-tree", "--exec-path", "--ext-diff"]
      }
    ]
  }
}
