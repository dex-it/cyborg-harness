{
  "id": "echo",
  "version": "1.0.0",
  "engines": {
    "cyborg": "^1"
  },
  "provides": {
    "demo.echo": "1.0"
  },
  "commands": [
    "echo.ping",
    "echo.files",
    "echo.tty",
    "echo.terminal",
    "echo.mark"
  ],
  "permissions": {
    "fs.read": [
      "workspace"
    ],
    "pty": [
      "/bin/sh"
    ]
  },
  "keybindings": [
    {
      "key": "F2",
      "command": "echo.ping"
    }
  ],
  "contributes": {
    "menus": [
      { "id": "ping", "menu": "tools", "title": "Echo: пинг", "command": "echo.ping", "order": 100, "accelerator": "CmdOrCtrl+Alt+E" },
      { "id": "mark", "menu": "tools", "title": "Echo: отметка", "command": "echo.mark", "order": 200, "checked": { "contract": "demo.echo", "major": 1, "member": "marked" } }
    ]
  },
  "ui": {
    "views": {
      "main": "./ui/ui.js"
    }
  }
}
