{
  "id": "sessions",
  "version": "1.0.0",
  "engines": {
    "cyborg": "^1"
  },
  "consumes": {
    "cyborg.agent": "^1",
    "cyborg.session-prompt": "^1",
    "cyborg.agent-tool": "^1"
  },
  "commands": {
    "sessions.agents": {},
    "sessions.new": {
      "args": [
        "string"
      ]
    },
    "sessions.previous": {},
    "sessions.restore": {
      "args": [
        "string"
      ]
    }
  },
  "permissions": {
    "serve": true,
    "pty": [
      "/bin/sh",
      {
        "program": "$SHELL",
        "args": [
          "-lc",
          "exec claude --settings \"$CYBORG_SETTINGS\" \"$@\"",
          "cyborg"
        ],
        "env": [
          "CYBORG_EVENTS",
          "CYBORG_SETTINGS",
          "CYBORG_MCP_TOKEN"
        ]
      }
    ]
  },
  "documents": {
    "session": {
      "restorable": true,
      "area": "main",
      "order": 100
    }
  },
  "ui": {
    "views": {
      "main": { "module": "./ui/ui.js", "area": "main", "order": 100 }
    }
  }
}
