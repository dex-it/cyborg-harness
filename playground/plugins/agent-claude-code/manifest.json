{
  "id": "agent-claude-code",
  "version": "1.0.0",
  "engines": {
    "cyborg": "^1"
  },
  "provides": {
    "cyborg.agent": "1.0"
  },
  "permissions": {
    "process": [
      {
        "program": "$SHELL",
        "args": [
          "-lc",
          "claude --version"
        ]
      }
    ],
    "fs.read": [
      "~/.claude/projects"
    ]
  }
}
