{
  "id": "agent-claude-code",
  "version": "1.0.0",
  "engines": {
    "cyborg": "^1"
  },
  "provides": {
    "cyborg.agent": "1.0"
  },
  "permissions": {
    "process": [
      {
        "program": "$SHELL",
        "args": [
          "-lc",
          "claude --version"
        ],
        "deny": [
          "--dangerously-skip-permissions"
        ]
      }
    ],
    "fs.read": [
      "~/.claude/projects"
    ],
    "launch": [
      {
        "program": "$SHELL",
        "args": [
          "-lc",
          "exec claude --settings \"$CYBORG_SETTINGS\" \"$@\"",
          "cyborg"
        ],
        "env": [
          "CYBORG_EVENTS",
          "CYBORG_SETTINGS",
          "CYBORG_MCP_TOKEN"
        ]
      }
    ]
  }
}
