{
  "name": "cyborg-harness-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сайт документации Cyborg Harness (Starlight)",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "brand": "node scripts/copy-brand.mjs",
    "dev": "npm run brand && astro dev",
    "api:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../scripts/api-reference.ts --check",
    "build": "npm run brand && npm run api:check && astro build",
    "verify": "node scripts/check-dist.mjs",
    "preview": "astro preview",
    "check": "npm run brand && npm run api:check && astro check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.7",
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.7",
    "mermaid": "12.3.0",
    "satteri": "0.11.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3"
  }
}
