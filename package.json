{
  "name": "cyborg-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Ядро плагинов Cyborg Harness и playground-приложение на Electron для проверки его вживую",
  "main": "playground/dist/main.js",
  "scripts": {
    "build": "node playground/scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p core && node node_modules/typescript7/bin/tsc --noEmit -p playground",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'core/test/*.test.ts' 'playground/src/**/*.test.ts' 'playground/test/*.test.ts'",
    "demo": "node core/examples/run.ts",
    "smoke": "npm run build && node playground/scripts/smoke.mjs",
    "spike": "npm run build && node playground/scripts/spike-iframe.mjs",
    "spike:hosts": "npm run build && node playground/scripts/spike-hosts.mjs",
    "lint": "eslint --max-warnings 0 .",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
