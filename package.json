{
  "name": "cyborg-harness",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "contracts",
    "core",
    "electron",
    "testing",
    "tools/cyborg-plugin"
  ],
  "description": "Ядро плагинов Cyborg Harness и playground-приложение на Electron для проверки его вживую",
  "main": "playground/dist/main.js",
  "scripts": {
    "build:core": "node core/scripts/build.mjs",
    "build:testing": "node testing/scripts/build.mjs",
    "build:electron": "node electron/scripts/build.mjs",
    "build:tools": "node tools/cyborg-plugin/scripts/build.mjs && npm rebuild cyborg-plugin --ignore-scripts",
    "build:packages": "npm run build:core && npm run build:testing && npm run build:electron && npm run build:tools",
    "prebuild": "npm run build:packages",
    "build": "node playground/scripts/build.mjs",
    "start": "npm run build && electron .",
    "pretypecheck": "npm run build:packages",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p core && node node_modules/typescript7/bin/tsc --noEmit -p core/elements && node node_modules/typescript7/bin/tsc --noEmit -p testing && node node_modules/typescript7/bin/tsc --noEmit -p electron && node node_modules/typescript7/bin/tsc --noEmit -p tools/cyborg-plugin && node node_modules/typescript7/bin/tsc --noEmit -p templates/plugin && node node_modules/typescript7/bin/tsc --noEmit -p playground && node node_modules/typescript7/bin/tsc --noEmit -p scripts",
    "pretest": "npm run build:packages",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-force-exit --test-timeout=120000 'core/test/*.test.ts' 'contracts/test/*.test.ts' 'testing/test/*.test.ts' 'electron/test/*.test.ts' 'playground/src/**/*.test.ts' 'playground/test/*.test.ts' 'tools/cyborg-plugin/test/*.test.ts' 'templates/plugin/test/*.test.ts' 'scripts/test/*.test.ts'",
    "pretest:acceptance": "npm run build:packages",
    "test:acceptance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-force-exit --test-timeout=120000 --test-name-pattern='ST-\\d{4}/\\d+' 'core/test/*.test.ts' 'contracts/test/*.test.ts' 'testing/test/*.test.ts' 'electron/test/*.test.ts' 'playground/src/**/*.test.ts' 'playground/test/*.test.ts' 'tools/cyborg-plugin/test/*.test.ts' 'templates/plugin/test/*.test.ts' 'scripts/test/*.test.ts'",
    "demo": "node core/examples/run.ts",
    "smoke": "npm run build && node playground/scripts/smoke.mjs",
    "pack:delivery": "npm run build && node playground/scripts/pack-delivery.mjs",
    "spike": "npm run build && node playground/scripts/spike-iframe.mjs",
    "spike:hosts": "npm run build && node playground/scripts/spike-hosts.mjs",
    "spike:fsync": "node playground/scripts/spike-fsync.mjs",
    "spike:gateway": "npm run build && node playground/scripts/spike-gateway.mjs",
    "spike:groups": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON playground/scripts/spike-groups.mjs",
    "spike:monaco": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON playground/scripts/spike-monaco.mjs",
    "spike:pty": "node playground/scripts/spike-pty.mjs",
    "pilot:files": "npm run build:packages && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON playground/scripts/pilot-files.mjs",
    "pilot:trackers-http": "npm run build:packages && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON playground/scripts/pilot-trackers-http.mjs",
    "pilot:sessions": "npm run build && node playground/scripts/pilot-sessions.mjs",
    "spike:pty-stream": "npm run build && node playground/scripts/spike-pty-stream.mjs",
    "spike:pty-restore": "node playground/scripts/spike-pty-restore.mjs",
    "spike:notify-chain": "npm run build:packages && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON playground/test/measure-notify-chain.ts",
    "prelint": "npm run build:packages",
    "build:contracts": "node contracts/scripts/build.ts",
    "check:contracts": "node contracts/scripts/check-api.ts",
    "snapshot:contracts": "node contracts/scripts/check-api.ts --update",
    "snapshot:api": "node core/scripts/api-surface.ts --update",
    "lint": "node scripts/lint.mjs",
    "check:docs-links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs-links.ts docs README.md",
    "docs:api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/api-reference.ts --write",
    "check:docs-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/api-reference.ts --check",
    "check:docs-trace": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs-trace.ts",
    "check:acceptance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-acceptance.ts",
    "check:budgets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-budgets.ts",
    "release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/release.ts",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "0.58.0-dev-20261109",
    "node-pty": "^1.1.0"
  }
}
